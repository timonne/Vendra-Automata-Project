# ==========================================
# Root Environment Configuration Template
# ==========================================

# Backend Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# CORS Configuration (comma-separated origins or *)
CORS_ORIGIN=http://localhost:5173,http://localhost:8443,http://localhost:3000

# Frontend Configuration
# When deployed separately (e.g. Vercel), set to your deployed backend URL:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
# When deployed together or using proxy, keep empty or relative:
VITE_API_BASE_URL=/api
